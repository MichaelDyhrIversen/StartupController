<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <StartupObject>StartupController.Program</StartupObject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PackageIcon>startup128x128.png</PackageIcon>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
	  <!-- disable SDK auto-generation of assembly attributes so GeneratedVersionInfo.cs is authoritative -->
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="favicon.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.MD">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="startup128x128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<!-- NEW: increment build number before compile -->
	<Target Name="IncrementBuildNumber" BeforeTargets="BeforeCompile">
		<Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(SolutionDir)tools\Increment-BuildVersion.ps1&quot; -BuildNumberFile &quot;$(SolutionDir)tools\buildnumber.txt&quot; -OutputDir &quot;$(ProjectDir)Properties&quot; -Major 1 -Minor 0" />
	</Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(SolutionDir)tools\Update-VdprojVersion.ps1&quot; -VdprojPath &quot;$(SolutionDir)SetupStartupController\SetupStartupController.vdproj&quot; -AssemblyPath &quot;$(TargetPath)&quot; -UpdateProductCode" />
  </Target>

</Project>